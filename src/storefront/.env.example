# Storefront -> Store API de Medusa
MEDUSA_BACKEND_URL=http://localhost:9001
# Publishable key (no secreta) ligada al sales channel "Tienda Ciclismo".
# Generar/recuperar con: npx medusa exec ./src/scripts/ensure-publishable-key.ts
MEDUSA_PUBLISHABLE_KEY=
# Region COP para que la Store API calcule precios
MEDUSA_REGION_ID=
