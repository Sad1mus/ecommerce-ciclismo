# ==========================================================================
# Ecommerce Ciclismo — variables de entorno (COPIAR a .env y rellenar)
# ==========================================================================

# --- Base de datos / cache ---
# Nota: puertos host 5433/6380 para no chocar con otros stacks locales (etherlabx usa 5432/6379)
DB_PASS=ciclismo_dev
DATABASE_URL=postgresql://ciclismo:ciclismo_dev@localhost:5433/ciclismo
REDIS_URL=redis://localhost:6380

# --- Medusa ---
JWT_SECRET=cambia-esto-en-produccion
COOKIE_SECRET=cambia-esto-en-produccion

# --- Bot Telegram (Fase 2+) ---
TELEGRAM_BOT_TOKEN=
# CONTROL DE ACCESO (allowlist). El bot OPERA el negocio (crea/factura/despacha):
# si dejas AMBOS vacios queda ABIERTO (cualquiera que lo encuentre puede operarlo)
# y avisa por WARNING al arrancar. Pon los chat_id autorizados para restringirlo.
# Descubre tu chat_id escribiendole a @userinfobot en Telegram. Admiten varios
# separados por comas. TELEGRAM_ALLOWED_CHAT_IDS es un extra opcional (misma lista).
ADMIN_CHAT_ID=
BODEGA_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
# Rate-limit por chat_id (protege el cupo diario del LLM ante spam). Defaults sanos.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60
# El historial de conversacion se persiste en Redis (REDIS_URL, arriba) para sobrevivir
# reinicios; si Redis no esta, degrada a memoria (se pierde al reiniciar).

# --- Medusa para el bot (Store/Admin API; src/bot/medusa_client.py) ---
# La publishable key NO es secreta (se expone al navegador). Generarla/recuperarla
# con: npx medusa exec ./src/scripts/ensure-publishable-key.ts (ligada a "Tienda Ciclismo").
# El region_id es el de Colombia/COP; descúbrelo en GET /store/regions (currency_code=cop).
MEDUSA_BACKEND_URL=http://localhost:9001
MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MEDUSA_REGION_ID=reg_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Sales channel "Tienda Ciclismo" (lo usa crear_pedido). Descubrelo en GET /admin/sales-channels.
MEDUSA_SALES_CHANNEL_ID=sc_xxxxxxxxxxxxxxxxxxxxxxxxxx
MEDUSA_ADMIN_TOKEN=        # opcional, solo para /pedidos (Admin API)
# Credenciales admin para el E2E (lee stocked_quantity de la Admin API). Solo DEV.
# Crea el usuario con: npx medusa user -e <email> -p <password>
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
STOREFRONT_URL=http://localhost:8000

# --- Voz / LLM del bot (Fase 3 — a decidir) ---
# STT por defecto: Groq (Whisper large-v3), capa gratuita y compatible con OpenAI.
# Conseguir la key en https://console.groq.com/keys (NO pegarla en chats ni commits).
GROQ_API_KEY=
# Modelo del cerebro conversacional. 70b-versatile es fiable con tool-calling;
# 8b-instant tiene mas cupo pero FALLA eligiendo/formateando herramientas (no usar).
# El limite gratuito es POR MODELO; subir cupo = Dev tier en console.groq.com.
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=       # alternativa de pago (whisper-1); o Whisper local
OPENROUTER_KEY=
ANTHROPIC_KEY=

# --- Pagos Colombia (Fase 4) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
